# ─── Rexus configuration ───────────────────────────────────────────────
# Copy to .env and fill in. Changing anything here needs a restart.
# Never commit .env.

# ── Instance ──
REXUS_COMPANY_NAME=Rexus
REXUS_BASE_URL=http://localhost:8080
REXUS_PORT=8080

# Any Postgres connection string. (docker-compose.yml overrides this to use
# its bundled Postgres.)
DATABASE_URL=postgres://rexus:rexus@localhost:5432/rexus?sslmode=disable

# docker-compose.yml only: password for the bundled Postgres, and the
# localhost port it's exposed on (change if 5432 is already in use).
POSTGRES_PASSWORD=rexus
POSTGRES_HOST_PORT=5432

# Master encryption key (32 bytes, base64). REQUIRED. Generate with:
#   rexus keygen        (or: openssl rand -base64 32)
# Keep it safe and separate from backups — without it, encrypted data
# (2FA secrets, job headers, vault secrets) can't be decrypted.
REXUS_MASTER_KEY=

# ── Toggles ──
# production | development
REXUS_ENV=production

# required | admins | optional | off
REXUS_2FA_MODE=required

# true = lockdown: only the owner can log in
REXUS_LOGIN_OWNER_ONLY=false

# 0.0.0.0 = allow all, or comma-separated IPs/CIDRs (enforced from Phase 3)
REXUS_IP_ALLOWLIST=0.0.0.0

# Backups (Phase 6). Off by default — enable on the machine that keeps them.
REXUS_BACKUP_ENABLED=false
# Folder OUTSIDE the app folder: local disk, external drive, pendrive.
REXUS_BACKUP_DIR=

# Modules
REXUS_MODULE_SCHEDULER=true
REXUS_MODULE_VAULT=true
